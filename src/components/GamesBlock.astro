---
/*
 * "Play to games": a neon, glitchy card with a stylised rocker-construct silhouette in the
 * background (aviators, long hair, chrome arm). An original drawing that nods to Johnny
 * Silverhand without using any game artwork.
 */
interface Props { item: { title: string; text: string[]; tags: string[]; callout?: string } }
const { item } = Astro.props;
---
<div class="games">
  <svg class="games__art" viewBox="0 0 400 500" aria-hidden="true" preserveAspectRatio="xMaxYMax meet">
    <defs>
      <linearGradient id="g-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--c-raise)" />
        <stop offset="1" stop-color="var(--c-bg)" />
      </linearGradient>
      <linearGradient id="g-lens" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--c-signal)" />
        <stop offset="1" stop-color="#ff2e88" />
      </linearGradient>
      <pattern id="g-scan" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="4" height="2" fill="var(--c-bg)" opacity="0.55" /></pattern>
    </defs>
    <g class="games__fig">
      <!-- torso and shoulders -->
      <path d="M150 222 L250 222 L332 262 L356 500 L44 500 L68 262 Z" fill="url(#g-body)" stroke="var(--c-trace)" stroke-width="1.5" />
      <path d="M168 222 L200 300 L232 222" fill="none" stroke="var(--c-line)" stroke-width="2" />
      <!-- hair -->
      <path d="M138 150 Q130 66 202 64 Q274 68 266 152 L276 262 Q246 246 242 206 L160 206 Q156 246 124 262 Z" fill="var(--c-bg)" stroke="#ff2e88" stroke-width="1.5" />
      <!-- face -->
      <ellipse cx="201" cy="152" rx="50" ry="62" fill="url(#g-body)" />
      <!-- beard -->
      <path d="M160 176 Q201 236 242 176 L240 198 Q201 244 162 198 Z" fill="var(--c-bg)" />
      <!-- aviators -->
      <path class="games__lens" d="M154 134 L196 134 L191 160 Q172 168 160 156 Z M206 134 L248 134 L242 156 Q230 168 211 160 Z" fill="url(#g-lens)" />
      <path d="M150 134 H252" stroke="var(--c-ink)" stroke-width="2" />
      <!-- chrome arm, raised to the glasses -->
      <g class="games__arm" fill="var(--c-raise)" stroke="var(--c-trace)" stroke-width="1.5">
        <rect x="300" y="262" width="44" height="64" rx="10" transform="rotate(-8 322 294)" />
        <rect x="292" y="200" width="38" height="62" rx="9" transform="rotate(-14 311 231)" />
        <rect x="282" y="146" width="34" height="56" rx="8" transform="rotate(-22 299 174)" />
        <path d="M262 120 l18 -6 l10 26 l-18 8 Z M276 112 l14 -4 l8 22 l-14 6 Z M250 128 l14 -4 l7 18 l-14 6 Z" />
        <path d="M304 210 h20 M300 222 h22 M294 160 h18 M290 172 h18" stroke="var(--c-signal)" stroke-width="1" />
      </g>
    </g>
    <rect width="400" height="500" fill="url(#g-scan)" />
  </svg>
  <div class="games__glow" aria-hidden="true"></div>

  <div class="games__body">
    <p class="osd games__label"><span class="games__dot" aria-hidden="true"></span>{item.title}</p>
    <div class="prose games__text">{item.text.map((t) => <p>{t}</p>)}</div>
    {item.callout && <p class="games__callout" data-text={item.callout}>{item.callout}</p>}
    <ul class="games__tags" role="list">{item.tags.map((t) => <li>{t}</li>)}</ul>
  </div>
</div>

<style>
  .games { position: relative; isolation: isolate; overflow: hidden; border: 1px solid var(--c-line); padding: clamp(1.4rem, 4vw, 2.6rem);
    min-height: 28rem; display: grid; align-items: end;
    background:
      radial-gradient(70% 90% at 90% 30%, color-mix(in srgb, #ff2e88 16%, transparent), transparent 60%),
      radial-gradient(60% 80% at 70% 100%, color-mix(in srgb, var(--c-trace) 14%, transparent), transparent 60%),
      var(--c-surface); }
  .games::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: linear-gradient(var(--c-signal), #ff2e88, var(--c-trace)); }
  .games__art { position: absolute; right: -2rem; bottom: 0; height: 115%; width: auto; max-width: 70%; z-index: -1; opacity: 0.55;
    filter: drop-shadow(0 0 18px color-mix(in srgb, #ff2e88 40%, transparent)); animation: games-glitch 7s steps(1, end) infinite; }
  .games__lens { filter: drop-shadow(0 0 6px var(--c-signal)); }
  .games__glow { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, var(--c-surface) 0%, color-mix(in srgb, var(--c-surface) 85%, transparent) 45%, transparent 75%); }
  @keyframes games-glitch {
    0%, 90%, 100% { transform: none; clip-path: none; }
    91% { transform: translateX(-6px); clip-path: inset(20% 0 55% 0); }
    92% { transform: translateX(5px); clip-path: inset(60% 0 10% 0); }
    93% { transform: translateX(-2px); clip-path: none; }
  }
  .games__body { position: relative; display: grid; gap: 1.1rem; max-width: 40rem; }
  .games__label { display: inline-flex; align-items: center; gap: 0.6rem; color: #ff5fa8; text-transform: none; letter-spacing: 0.08em; font-size: var(--t-sm); }
  .games__dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #ff2e88; box-shadow: 0 0 12px #ff2e88; animation: blink 1.4s steps(1, end) infinite; }
  .games__callout { position: relative; font-family: var(--f-display); font-weight: 800; font-size: clamp(1.6rem, 1rem + 3vw, 3rem); line-height: 1; letter-spacing: -0.03em; color: var(--c-ink); }
  .games__callout::before, .games__callout::after { content: attr(data-text); position: absolute; inset: 0; pointer-events: none; clip-path: inset(0 0 100% 0); }
  .games__callout::before { color: var(--c-trace); animation: t-split 6s steps(1, end) infinite; }
  .games__callout::after { color: #ff2e88; animation: t-split 6s steps(1, end) infinite reverse; }
  @keyframes t-split {
    0%, 88%, 100% { transform: none; clip-path: inset(0 0 100% 0); }
    89% { transform: translate(-4px, 0); clip-path: inset(15% 0 50% 0); }
    91% { transform: translate(4px, 0); clip-path: inset(55% 0 10% 0); }
    93% { clip-path: inset(0 0 100% 0); }
  }
  .games__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .games__tags li { font-family: var(--f-mono); font-size: var(--t-xs); padding: 0.25rem 0.6rem; border: 1px solid color-mix(in srgb, #ff2e88 45%, var(--c-line)); border-radius: 2px; background: color-mix(in srgb, var(--c-bg) 70%, transparent); }
  @media (max-width: 760px) {
    .games { min-height: 0; padding-top: 14rem; }
    .games__art { right: 50%; transform: translateX(50%); height: 17rem; max-width: none; top: 0; bottom: auto; animation: none; }
    .games__glow { background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--c-surface) 70%, transparent) 12rem, var(--c-surface) 15rem); }
  }
  @media (prefers-reduced-motion: reduce) { .games__art, .games__dot, .games__callout::before, .games__callout::after { animation: none; } }
</style>
