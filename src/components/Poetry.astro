---
import type { SiteContent } from '../content/types';
interface Props { content: SiteContent }
const p = Astro.props.content.poetry;
const id = Astro.props.content.nav[3].id;
---
<section class="poetry" id={id} aria-labelledby={`${id}-title`}>
  <div class="shell poetry__inner">
    <span class="osd ch-label">CH4 · {p.eyebrow}</span>
    <h2 class="visually-hidden" id={`${id}-title`}>{p.title}</h2>
    <div class="verse" data-decode-root data-decode data-glitch="poem" aria-label={p.lines.join(' ')}>
      {p.lines.map((l, i) => <p class="verse__line" style={`--i:${i}`}>{l}</p>)}
    </div>
    <p class="osd poetry__credit">{p.credit}</p>
    <div class="poetry__foot">
      <p class="poetry__title">{p.title}</p>
      <div class="prose">
        <p class="lead">{p.lead}</p>
        {p.paragraphs.map((t) => <p>{t}</p>)}
      </div>
    </div>
    {p.extras.map((x) => (
      <div class="music">
        <p class="osd music__label">{x.title}</p>
        <div class="prose music__text">{x.text.map((t) => <p>{t}</p>)}</div>
        <ul class="music__artists" role="list">{x.tags.map((a) => <li>{a}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<style>
  .poetry { position: relative; border-top: 1px solid var(--c-line); padding-block: clamp(5rem, 12vw, 11rem); background:
    linear-gradient(to right, var(--c-grid) 1px, transparent 1px) 0 0 / 4rem 4rem,
    linear-gradient(to bottom, var(--c-grid) 1px, transparent 1px) 0 0 / 4rem 4rem,
    var(--c-bg); }
  .poetry__inner { display: grid; gap: 3rem; }
  .ch-label { display: inline-flex; gap: 0.5rem; align-items: center; }
  .ch-label::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c-trace); box-shadow: 0 0 12px var(--c-trace); }
  .verse { display: grid; gap: 0.2em; font-family: var(--f-display); font-weight: 300; font-size: clamp(2rem, 1rem + 4.6vw, 5.4rem); line-height: 1.04; letter-spacing: -0.03em; font-variation-settings: 'opsz' 96; }
  .verse__line { max-width: 22ch; text-wrap: balance; }
  .poetry__credit { margin-top: -1.5rem; text-transform: none; letter-spacing: 0.04em; }
  .verse__line:nth-child(even) { padding-left: clamp(1rem, 10vw, 10rem); color: var(--c-muted); }
  .verse__line:last-child { color: var(--c-signal); font-weight: 600; text-shadow: 0 0 28px var(--c-glow); }
  .poetry__foot { display: grid; grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); border-top: 1px solid var(--c-line); padding-top: 2rem; }
  .poetry__title { font-family: var(--f-display); font-weight: 800; font-size: var(--t-xl); line-height: 1.05; }
  .music { display: grid; grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr); gap: 1.2rem clamp(1.5rem, 4vw, 4rem); border-top: 1px solid var(--c-line); padding-top: 2rem; }
  .music__label { color: var(--c-trace); }
  .music__artists { grid-column: 2; list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .music__artists li { font-family: var(--f-mono); font-size: var(--t-xs); padding: 0.25rem 0.6rem; border: 1px solid var(--c-line); border-radius: 2px; color: var(--c-ink); background: color-mix(in srgb, var(--c-bg) 80%, transparent); }
  @media (max-width: 760px) { .poetry__foot, .music { grid-template-columns: 1fr; } .music__artists { grid-column: 1; } }
</style>
