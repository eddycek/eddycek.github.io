---
import type { SiteContent } from '../content/types';
import Channel from './Channel.astro';
interface Props { content: SiteContent }
const w = Astro.props.content.workshop;
const id = Astro.props.content.nav[2].id;
const flagship = w.items.find((i) => i.flagship) ?? w.items[0];
const others = w.items.filter((i) => i !== flagship);
---
<Channel id={id} index={3} eyebrow={w.eyebrow} title={w.title} lead={w.lead} meta="@EDDYCEK">
  <article class="flag">
    <div class="flag__scope">
      <canvas id="spectrum" aria-hidden="true"></canvas>
      <span class="osd flag__label">GYRO ROLL · FFT 256 · BLACKBOX</span>
    </div>
    <div class="flag__text">
      <span class="osd osd--signal">{flagship.tagline}</span>
      <h3 class="flag__name">{flagship.url ? <a href={flagship.url}>{flagship.name}</a> : flagship.name}</h3>
      <p>{flagship.description}</p>
      <ul class="tags" role="list">{flagship.tags.map((t) => <li>{t}</li>)}</ul>
      {flagship.url && <a class="osd flag__cta" href={flagship.url}>{flagship.linkLabel ?? 'github.com/eddycek/fpvpidlab'} ↗</a>}
    </div>
  </article>
  {others.length > 0 && <ul class="bench" role="list">
    {others.map((p) => (
      <li class="bench__item">
        {p.url ? (
          <a class="bench__row" href={p.url}>
            <span class="bench__name">{p.name}</span>
            <span class="bench__desc">{p.description}</span>
            <span class="osd bench__tags">{p.tags.join(' · ')}{p.linkLabel && <span class="bench__link"> · {p.linkLabel}</span>}</span>
            <span class="bench__arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <div class="bench__row">
            <span class="bench__name">{p.name}</span>
            <span class="bench__desc">{p.description}</span>
            <span class="osd bench__tags">{p.tags.join(' · ')}</span>
          </div>
        )}
      </li>
    ))}
  </ul>}
</Channel>

<style>
  .flag { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); border: 1px solid var(--c-line); background: var(--c-surface); }
  .flag__scope { position: relative; min-height: 20rem; background: var(--c-bg); border-right: 1px solid var(--c-line); }
  .flag__scope canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .flag__label { position: absolute; left: 0.9rem; top: 0.8rem; pointer-events: none; }
  .flag__text { padding: clamp(1.25rem, 3vw, 2.2rem); display: grid; gap: 0.9rem; align-content: start; }
  .flag__name { font-size: var(--t-xl); }
  .flag__name a { text-decoration: none; }
  .flag__text p { color: var(--c-muted); }
  .flag__cta { color: var(--c-signal); text-decoration: none; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { font-family: var(--f-mono); font-size: var(--t-xs); padding: 0.15rem 0.5rem; border: 1px solid var(--c-line); border-radius: 2px; color: var(--c-muted); }
  .bench { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; }
  .bench__row { display: grid; grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr) auto; gap: 0.4rem 1.5rem; align-items: baseline; padding: 1.1rem 0.25rem; border-top: 1px solid var(--c-line); text-decoration: none; transition: background 0.2s, padding 0.2s; }
  .bench__item:last-child .bench__row { border-bottom: 1px solid var(--c-line); }
  a.bench__row:hover { background: var(--c-surface); padding-inline: 1rem 0.5rem; }
  .bench__name { font-family: var(--f-display); font-weight: 600; font-size: var(--t-lg); }
  .bench__desc { color: var(--c-muted); }
  .bench__tags { grid-column: 2; }
  .bench__link { color: var(--c-signal); }
  .bench__arrow { grid-row: 1; grid-column: 3; color: var(--c-signal); }
  @media (max-width: 860px) {
    .flag { grid-template-columns: 1fr; }
    .flag__scope { border-right: 0; border-bottom: 1px solid var(--c-line); min-height: 15rem; }
    .bench__row { grid-template-columns: minmax(0, 1fr) auto; }
    .bench__desc, .bench__tags { grid-column: 1; }
    .bench__arrow { grid-column: 2; }
  }
</style>
