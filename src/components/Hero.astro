---
import type { SiteContent } from '../content/types';
interface Props { content: SiteContent }
const { content } = Astro.props;
const h = content.hero;
const [first, ...rest] = h.name.split(' ');
// The 'noise' word in the claim keeps glitching on its own.
const claimParts = h.claim.split(/(šumu|noise)/);
---
<section class="hero" id="signal" aria-labelledby="hero-name">
  <canvas class="hero__scope" id="scope" aria-hidden="true"></canvas>
  <figure class="hero__portrait" data-portrait>
    <img src="/portrait/eddy-960.webp" srcset="/portrait/eddy-560.webp 560w, /portrait/eddy-960.webp 960w" sizes="(max-width: 760px) 70vw, 42vw" width="960" height="1280" alt={h.portraitAlt} fetchpriority="high" decoding="async" />
    <canvas aria-hidden="true"></canvas>
    <figcaption class="osd hero__cam" aria-hidden="true"><span class="hero__cam-dot"></span>CAM 01 · <span data-lock>STANDBY</span><span class="hero__cam-id"> · ID EDDYCEK</span></figcaption>
  </figure>
  <div class="hero__scan" aria-hidden="true"></div>
  <div class="hero__hud" aria-hidden="true" data-on="0">
    <div class="hero__hud-row"><span>SIGNAL INTEGRITY</span><span data-hud-pct>100%</span></div>
    <div class="hero__hud-bar">{Array.from({ length: 20 }, () => <i data-hud-seg data-lit></i>)}</div>
  </div>

  <div class="hero__osd hero__osd--tl osd" aria-hidden="true">
    <span class="osd--signal">● REC</span>
    <span>T+ <span id="uptime">0000d</span></span>
  </div>
  <div class="hero__osd hero__osd--tr osd" aria-hidden="true">
    <span>LQ 99</span><span>5.8G</span><span id="clock" title="Unix epoch">0x00000000</span>
  </div>

  <div class="hero__inner shell">
    <p class="osd osd--signal hero__status">{h.osd}</p>
    <h1 class="hero__name" id="hero-name" aria-label={h.name} data-decode data-glitch="name">
      <span class="hero__line hero__line--scan">{first}</span>
      <span class="hero__line hero__line--indent">{rest.join(' ')}</span>
    </h1>
    <p class="hero__handle"><span class="osd">a.k.a.</span> <span class="hero__nick" data-decode data-glitch="name">eddycek</span></p>
    <p class="hero__claim" aria-label={h.claim}>{claimParts.map((x) => (x === 'šumu' || x === 'noise') ? <span class="hero__noise" data-decode data-glitch="poem">{x}</span> : x)}</p>
    <p class="hero__intro">{h.intro}</p>
    <ul class="hero__tags" role="list">
      {h.tags.map((t) => <li>{t}</li>)}
    </ul>
  </div>

  <p class="hero__osd hero__osd--bl osd hero__poke" aria-hidden="true">{h.clickHint}</p>
  <a class="hero__osd hero__osd--br osd hero__hint" href={`#${content.nav[0].id}`}>{h.scrollHint} ↓</a>
</section>

<style>
  .hero { cursor: crosshair; position: relative; grid-template-columns: minmax(0, 1fr); min-height: min(100svh - var(--bar-h), 60rem); display: grid; align-items: center; overflow: hidden; isolation: isolate; background: radial-gradient(120% 80% at 70% 40%, color-mix(in srgb, var(--c-signal) 7%, transparent), transparent 60%), var(--c-bg); }
  :global(.hero.is-failsafe) .hero__scope { z-index: 5; }
  .hero__scope { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; display: block; }
  .hero__scan { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: repeating-linear-gradient(to bottom, transparent 0 2px, color-mix(in srgb, var(--c-bg) 22%, transparent) 2px 3px); mix-blend-mode: multiply; opacity: 0.6; }
  .hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 1.4rem; padding-block: 6rem 7rem; width: 100%; pointer-events: none; }
  .hero__inner a, .hero__inner li { pointer-events: auto; }
  .hero__status { letter-spacing: 0.2em; }
  .hero__name { font-size: var(--t-hero); font-weight: 800; line-height: 0.86; letter-spacing: -0.045em; font-variation-settings: 'opsz' 96; display: grid; }
  .hero__line { display: block; }
  /* Safari only clips a text background on the element that owns the text node, so the decode
     spans (.sd-c) need the same scanline fill or the line disappears on iPhone. */
  .hero__line--scan, .hero__line--scan :global(.sd-c) { color: transparent; -webkit-text-fill-color: transparent; background: repeating-linear-gradient(to bottom, var(--c-ink) 0 3px, color-mix(in srgb, var(--c-ink) 62%, transparent) 3px 5px); -webkit-background-clip: text; background-clip: text; }
  .hero__line--scan :global(.sd-c[data-g]) { background: none; }
  .hero__line--scan { filter: drop-shadow(-2px 0 0 color-mix(in srgb, var(--c-trace) 70%, transparent)) drop-shadow(2px 0 0 color-mix(in srgb, var(--c-signal) 70%, transparent)); }
  .hero__line--indent { padding-left: clamp(1rem, 9vw, 9rem); }
  .hero__handle { margin-top: -0.4rem; padding-left: clamp(1rem, 9vw, 9rem); font-family: var(--f-mono); font-size: clamp(1.05rem, 0.8rem + 1vw, 1.5rem); display: flex; align-items: baseline; gap: 0.7rem; }
  .hero__handle .osd { color: var(--c-muted); }
  .hero__nick { color: var(--c-signal); text-shadow: 0 0 18px var(--c-glow); }
  .hero__nick::after { content: '_'; animation: blink 1s steps(1, end) infinite; }
  .hero__noise { display: inline-block; }
  .hero__claim { font-family: var(--f-display); font-size: var(--t-xl); font-weight: 600; color: var(--c-signal); text-shadow: 0 0 24px var(--c-glow); letter-spacing: -0.01em; max-width: 24ch; }
  .hero__intro { max-width: 46ch; font-size: var(--t-lg); color: var(--c-ink); opacity: 0.86; line-height: 1.5; text-shadow: 0 1px 12px var(--c-bg); }
  .hero__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hero__tags li { font-family: var(--f-mono); font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.1em; padding: 0.3rem 0.65rem; border: 1px solid var(--c-line); border-radius: 2px; background: color-mix(in srgb, var(--c-bg) 70%, transparent); }
  .hero__hud { position: fixed; left: 50%; top: calc(var(--bar-h) + env(safe-area-inset-top, 0px) + 12px); z-index: 45; width: min(300px, calc(100% - 48px)); padding: 0.55rem 0.75rem 0.65rem; pointer-events: none;
    background: color-mix(in srgb, var(--c-bg) 86%, transparent); border: 1px solid var(--c-line); font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--c-ink);
    opacity: 0; transition: opacity 0.25s; transform: translateX(-50%); }
  .hero__hud[data-on='1'] { opacity: 1; }
  .hero__hud[data-hot='1'] { border-color: var(--c-signal); color: var(--c-signal); box-shadow: 0 0 18px var(--c-glow); }
  .hero__hud-row { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.45rem; }
  .hero__hud-bar { display: grid; grid-template-columns: repeat(20, 1fr); gap: 2px; }
  .hero__hud-bar i { height: 6px; background: var(--c-ink); opacity: 0.16; }
  .hero__hud-bar i[data-lit] { background: var(--c-trace); opacity: 0.95; }
  .hero__hud[data-hot='1'] .hero__hud-bar i[data-lit] { background: var(--c-signal); }
  .hero__osd { position: absolute; display: flex; gap: 1.2rem; z-index: 2; }
  .hero__osd--tl { top: 2.4rem; left: var(--gutter-l); }
  .hero__osd--tr { top: 2.4rem; right: var(--gutter-r); }
  .hero__osd--bl { bottom: 2.4rem; left: var(--gutter-l); margin: 0; color: var(--c-muted); }
  .hero__osd--br { bottom: 2.4rem; right: var(--gutter-r); }
  .hero__hint { padding-block: 0.5rem; text-decoration: none; color: var(--c-ink); animation: nudge 2.4s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(4px); } }

  /* Portrait: a cutout received as a video feed (src/scripts/signal/portrait.ts). It sits under the scope,
     pinned top right and dissolving downwards, so the traces run across it; the signal stays the hero, the face is in it. */
  .hero__portrait { --fade: linear-gradient(to bottom, #000 38%, transparent 94%); position: absolute; z-index: -3; margin: 0; top: 4.2rem; right: 0; height: min(80%, 56vw); aspect-ratio: 3 / 4; pointer-events: none;
    -webkit-mask-image: var(--fade), linear-gradient(to right, transparent 0, #000 18%); -webkit-mask-composite: source-in;
    mask-image: var(--fade), linear-gradient(to right, transparent 0, #000 18%); mask-composite: intersect; }
  .hero__portrait img, .hero__portrait canvas { position: absolute; inset: 4% 0 0 0; width: 100%; height: 96%;
    /* canvas: full box, the picture inside starts 4% down (portrait.ts) */ display: block; object-fit: contain; object-position: right top; }
  .hero__portrait canvas { opacity: 0; inset: 0; height: 100%; }
  /* The same cyan / orange split as "Vaclav" on the silhouette edge. Only the static <img> fallback uses CSS
     filters; the canvas has the split and halo baked in (portrait.ts), so nothing re-blurs while it animates. */
  .hero__portrait img { filter: drop-shadow(-2px 0 0 color-mix(in srgb, var(--c-trace) 45%, transparent)) drop-shadow(2px 0 0 color-mix(in srgb, var(--c-signal) 45%, transparent)) drop-shadow(0 0 22px color-mix(in srgb, var(--c-glow) 60%, transparent)); }
  :global(:root[data-theme='light']) .hero__portrait img { filter: drop-shadow(-1px 0 0 color-mix(in srgb, var(--c-trace) 45%, transparent)) drop-shadow(1px 0 0 color-mix(in srgb, var(--c-signal) 45%, transparent)); }
  :global(.hero__portrait.is-live) img { opacity: 0; }
  :global(.hero__portrait.is-live) canvas { opacity: 1; }
  .hero__cam { position: absolute; left: var(--cam-x, 18%); top: var(--cam-y, 4%); white-space: nowrap; display: flex; align-items: center; gap: 0.5rem; color: var(--c-trace); font-size: 10px; }
  .hero__cam-id { opacity: 0; transition: opacity 0.4s; }
  .hero__portrait[data-state='locked'] .hero__cam-id { opacity: 1; }
  .hero__cam-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-signal); box-shadow: 0 0 10px var(--c-glow); animation: blink 1.2s steps(1, end) infinite; }


  /* The figure keeps the picture's exact 3:4 ratio (height capped by width), so the fade always ends on the picture
     and never on a hard edge. */
  @media (max-width: 1100px) { .hero__portrait { height: min(80%, 50vw); } }
  /* Phones and narrow tablets: the face rides in the top right corner behind the status line and the name, bleeding
     off the edge (ear side). It takes no layout space; the copy starts where it always did. Above the scope here,
     so the grid doesn't cut the face. */
  @media (max-width: 900px) {
    .hero__portrait { --fade: linear-gradient(to bottom, #000 30%, transparent 78%); z-index: -1; top: 3.2rem; right: -14%; width: min(66%, 22rem); height: auto;
      -webkit-mask-image: var(--fade), linear-gradient(to right, transparent 0, #000 40%);
      mask-image: var(--fade), linear-gradient(to right, transparent 0, #000 40%); }
    .hero__inner { padding-top: 4.5rem; }
    .hero__handle { text-shadow: 0 0 12px var(--c-bg); }
    .hero__cam-id { display: none; }
    .hero__status { text-shadow: 0 0 8px var(--c-bg), 0 0 16px var(--c-bg); }
    /* Light theme: the dark shirt would swallow the dark name, so the bust fades out before the name starts. */
    :global(:root[data-theme='light']) .hero__portrait { --fade: linear-gradient(to bottom, #000 30%, transparent 66%); }
  }

  @media (min-width: 600px) and (max-width: 900px) { .hero__portrait { right: 0; width: min(48%, 24rem); } }
  @media (max-width: 480px) { .hero__cam { display: none; } }

  @media (max-width: 640px) {
    .hero__osd--tr span:not(:last-child) { display: none; }
    .hero__line--indent, .hero__handle { padding-left: 0; }
    .hero__poke { display: none; }
    .hero__name { font-size: clamp(3.4rem, 18vw, 4.8rem); }
    .hero__intro, .hero__claim { background: none; box-shadow: none; text-shadow: 0 0 10px var(--c-bg), 0 0 18px var(--c-bg), 0 1px 2px var(--c-bg); }
    .hero__scope { opacity: 1; }
    .hero__scan { mix-blend-mode: normal; opacity: 0.35; }
    .hero__line--scan { filter: none; }
  }
</style>

<script>
  const start = Date.UTC(2008, 5, 1);
  const up = document.getElementById('uptime');
  const clock = document.getElementById('clock');
  const tick = () => {
    const days = Math.floor((Date.now() - start) / 86400000);
    if (up) up.textContent = `${days}d`;
    // Nerd clock: Unix epoch seconds in hex, plus decimal on wider screens.
    const s = Math.floor(Date.now() / 1000);
    if (clock) clock.textContent = `EPOCH 0x${s.toString(16).toUpperCase()}${innerWidth > 640 ? ` · ${s}` : ''}`;
  };
  tick();
  setInterval(tick, 1000);
</script>
