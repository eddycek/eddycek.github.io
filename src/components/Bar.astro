---
import type { SiteContent } from '../content/types';
interface Props { content: SiteContent }
const { content } = Astro.props;
const other = content.lang === 'cs' ? '/en/' : '/';
const home = content.lang === 'cs' ? '/' : '/en/';
---
<header class="bar">
  <div class="bar__inner">
    <a class="bar__home" href={home} aria-label="Václav Eder">
      <span class="bar__rec" aria-hidden="true"></span>
      <span class="osd">V. EDER</span>
    </a>
    <nav class="bar__nav" aria-label={content.lang === 'cs' ? 'Sekce' : 'Sections'}>
      {content.nav.map((n, i) => (
        <a href={`#${n.id}`} data-nav={n.id}><span class="bar__n" aria-hidden="true">{`CH${i + 1}`}</span>{n.label}</a>
      ))}
    </nav>
    <div class="bar__tools">
      <a class="osd bar__lang" href={other} hreflang={content.lang === 'cs' ? 'en' : 'cs'}>{content.switchLabel}</a>
      <button class="bar__theme" type="button" id="theme-toggle" aria-label={content.lang === 'cs' ? 'Přepnout světlé a tmavé téma' : 'Toggle light and dark theme'}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
  <div class="bar__progress" aria-hidden="true"><span id="progress"></span></div>
</header>

<style>
  .bar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: color-mix(in srgb, var(--c-bg) 78%, transparent); backdrop-filter: blur(12px) saturate(1.2); -webkit-backdrop-filter: blur(12px) saturate(1.2); border-bottom: 1px solid var(--c-line); }
  .bar__inner { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter-l); padding-right: var(--gutter-r); height: var(--bar-h); display: flex; align-items: center; gap: 1.5rem; }
  .bar__home { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .bar__home .osd { color: var(--c-ink); }
  .bar__rec { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c-signal); box-shadow: 0 0 10px var(--c-glow); animation: rec 1.2s steps(1, end) infinite; }
  @keyframes rec { 50% { opacity: 0.15; } }
  .bar__nav { display: flex; gap: 1.4rem; margin-left: auto; font-family: var(--f-mono); font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.1em; }
  .bar__nav a { text-decoration: none; color: var(--c-muted); display: inline-flex; gap: 0.4rem; padding-block: 0.4rem; transition: color 0.2s; }
  .bar__nav a:hover, .bar__nav a[aria-current='true'] { color: var(--c-ink); }
  .bar__nav a[aria-current='true'] .bar__n { color: var(--c-signal); }
  .bar__n { color: var(--c-noise); }
  .bar__tools { display: flex; align-items: center; gap: 0.75rem; }
  .bar__lang { text-decoration: none; color: var(--c-ink); border: 1px solid var(--c-line); padding: 0.25rem 0.55rem; border-radius: 3px; }
  .bar__lang:hover { border-color: var(--c-signal); }
  .bar__theme { background: none; border: 1px solid var(--c-line); color: var(--c-ink); width: 2rem; height: 2rem; border-radius: 3px; display: grid; place-items: center; cursor: pointer; }
  .bar__theme:hover { border-color: var(--c-signal); color: var(--c-signal); }
  .bar__progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; }
  .bar__progress span { display: block; height: 100%; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--c-signal); box-shadow: 0 0 8px var(--c-glow); }
  @media (max-width: 860px) { .bar__nav { display: none; } .bar__tools { margin-left: auto; } }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* storage unavailable */ }
  });

  const bar = document.getElementById('progress');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      ticking = false;
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((a) => links.set(a.dataset.nav ?? '', a));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a, id) => a.setAttribute('aria-current', String(id === e.target.id)));
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  links.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
</script>
